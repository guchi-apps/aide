# AIDE の設定。実際の値は .env に置く（.env はコミットしない）。
# ここにあるのは公開URLとCSSセレクタで、機密情報ではない。
# APIキー・トークン類を追加する場合は 1Password の op:// 参照を使うこと。

# ---- サーバー ----
# HOST=127.0.0.1
# PORT=4747

# ---- Zaim ----
# Zaim は公式APIで残高を取れないため、Playwright で画面を巡回して取得する。
# 初回は GUI のある端末で手動ログインして storage state を保存する。
#   node src/core/connectors/zaim/scripts/login.mjs

ZAIM_LOGIN_URL=https://zaim.net/
ZAIM_BALANCE_URL=https://zaim.net/home

# ログイン状態の保存先。未設定なら data/zaim/storage-state.json（リポジトリ基準）。
# ZAIM_STORAGE_STATE_PATH=

# ---- Zaim: 自動再ログイン（任意）----
# セッションが失効したときに自動でログインし直すための資格情報（#63）。
# **両方を設定したときだけ有効になる。** 未設定なら従来どおり ZAIM_SESSION_EXPIRED で
# 失敗させ、手動ログインをやり直す運用になる（開発機・CIではこちらが既定）。
#
# 値の正は 1Password（op://apps/aide/zaim-email / op://apps/aide/zaim-password）に置く。
# 実行時に 1Password は呼ばないため、worker が動くサブPCの .env へ人が転記する。
# **VPS側には要らない**（worker はサブPCで動き、VPSはキャッシュを読むだけ）。
ZAIM_EMAIL=
ZAIM_PASSWORD=

# ログイン画面のセレクタ。未設定なら type/name 属性から総当たりで探す。
# Zaim のログインは id.kufu.jp の SSO 画面へ飛び、構成が変わりうるため上書き口を用意する。
ZAIM_LOGIN_EMAIL_SELECTOR=
ZAIM_LOGIN_PASSWORD_SELECTOR=
ZAIM_LOGIN_SUBMIT_SELECTOR=

# 残高一覧の抽出。未設定の場合は「名称＋円金額」を総当たりで拾うフォールバックが働くが、
# 誤検出を避けるため実運用ではセレクタを指定する。
ZAIM_BALANCE_ROW_SELECTOR="section.box.home-balance div.col-xs-7.text.account-name"
ZAIM_BALANCE_NAME_SELECTOR=.name
ZAIM_BALANCE_AMOUNT_SELECTOR=.value

# 証券は残高一覧に合計しか出ないため、詳細ページを巡回して個別銘柄を取得する。
# 未設定なら a[href*="/securities/"] を使う。
ZAIM_SECURITIES_LINK_SELECTOR=
ZAIM_SECURITIES_ACCOUNT_NAME_SELECTOR=h2

# 証券詳細ページの表は列構成が揃わないため、ヘッダー見出しで評価額の列を特定する。
ZAIM_SECURITIES_HOLDING_TABLE_SELECTOR=table
ZAIM_SECURITIES_HOLDING_NAME_HEADERS=銘柄,ファンド名
ZAIM_SECURITIES_HOLDING_AMOUNT_HEADERS=評価額

# 表から取れない場合に使う行セレクタ。
ZAIM_SECURITIES_HOLDING_ROW_SELECTOR=
ZAIM_SECURITIES_HOLDING_NAME_SELECTOR=
ZAIM_SECURITIES_HOLDING_AMOUNT_SELECTOR=

# ---- Zaim 連携口座の更新（zaim-refresh）----
# 連携口座は「データを更新する」を押すまで各金融機関から再取得されない。押さないまま巡回すると
# その日の資産額として古い残高が記録されるため、巡回の前にこのページのボタンを押す。
# 口座ごとの「最終更新」もこのページにしか出ない。
# ZAIM_ONLINE_ACCOUNTS_URL=https://zaim.net/online_accounts

# 口座名と最終更新の抽出。未設定なら「最終更新」を含むブロックから総当たりで拾う。
# 実物の画面で拾えていなければ指定する（クラス名はハッシュ付きで変わるため要素の構造で書く）。
ZAIM_ONLINE_ACCOUNT_ROW_SELECTOR=
ZAIM_ONLINE_ACCOUNT_NAME_SELECTOR=

# 押してから反映まで多くの口座は5〜15分だが、SBI証券などは約35分かかる。上限（ミリ秒・既定は45分）。
# 短くすると、更新が終わる前に打ち切って「更新できなかった口座」が増える。
# ZAIM_REFRESH_MAX_WAIT_MS=2700000

# 1 にするとボタンを押さず、いま読めている口座と最終更新を出力するだけになる（画面の確認用）。
# ZAIM_REFRESH_DRY_RUN=1

# ---- Zaim Web版の入力画面からの登録（#214）----
# 公式APIで作った明細はZaimの「レシート置き換え」の候補にならない。置き換えに載せたい明細だけは
# この画面（品目明細の入力フォーム）を人と同じように操作して作る。
# **巡回と同じログイン状態（storage state）を使う。** つまり動くのはサブPCだけで、VPSでは使えない。
# ZAIM_RECEIPT_URL=https://zaim.net/money/new

# 入力フォームのセレクタ。未設定なら #money_new_form。
# 中の入力欄は name 属性・placeholder・ラベルの文言で当てており、個別の上書き口は用意していない
# （CSS Modulesのハッシュ付きクラス名はデプロイごとに変わるため、そもそも当てにしていない）。
# ZAIM_RECEIPT_FORM_SELECTOR=#money_new_form

# 1 にすると**送信だけ行わない**。フォームを最後まで埋めて、埋まった内容を出力して終える。
# Zaimに明細を作らずに画面の当て方を確かめられる（ZAIM_REFRESH_DRY_RUN と同じ考え方）。
# ZAIM_WEB_PAYMENT_DRY_RUN=1

# ---- Zaim Web版登録の受け口と中継（#215）----
# 呼び出し元（asset-manager）もAIDEのサーバーもVPSにいる一方、上の登録が成立するのは
# storage state と Playwright があるサブPCだけ。そのため**2つに分けて設定する**。
#
#   サブPC … 受け口を常駐させる（npm run zaim-web-server / aide-zaim-web.service）
#   VPS   … 自分で画面を操作せず、その受け口へ中継する
#
# 【サブPC側】受け口が待ち受けるアドレスとポート。既定は 127.0.0.1:4748。
# **本番では Tailscale のアドレスを明示する。** この口はZaimへの書き込みそのものなので、
# LANや外へは出さない。ポートの既定は本体（4747）の隣に置いて衝突を避けている。
# AIDE_ZAIM_WEB_HOST=100.x.y.z
# AIDE_ZAIM_WEB_PORT=4748
#
# **サブPC側にも AIDE_ZAIM_WRITE_SECRET が要る**（受け口の認証に使う。VPSと同じ値にする）。
# 上の「Zaimへの支出登録」の節にある値のうち、サブPCで要るのはこの1つだけ。
# OAuthの4つ（AIDE_ZAIM_CONSUMER_* / AIDE_ZAIM_ACCESS_*）は公式API用でVPSにしか要らない。
#
# 【VPS側】中継先URL。設定すると POST /api/zaim/payment/web はここへ転送する。
# 未設定なら従来どおり自分で画面を操作しようとして失敗する（storage state が無いため）。
# **受け口側では設定しない**（設定されていると受け口は起動を拒否する）。
# 実値は本番の .env と 1Password（op://apps/aide/zaim-web-upstream-url）にだけ置く。
AIDE_ZAIM_WEB_UPSTREAM_URL=

# ---- 認証（必須）----
# 未設定だとサーバーは起動しない。認証なしで動かす場合は AIDE_AUTH_DISABLED=1 を明示する。
# 本番では 1Password から注入する。
AIDE_AUTH_PASSWORD=

# OAuthメタデータに載せる公開URL。リバースプロキシ配下ではHostから推測できないため明示する。
# 例: https://aide.gucchii.com
AIDE_BASE_URL=

# ---- 動作状況ページ（/status）のGoogleログイン（#90）----
# 他アプリ（dayspan・shopping-list）と同じ共有SupabaseプロジェクトのGoogleログインを使い、
# 許可したメールアドレスの人だけが画面を開けるようにする。
#
# **3つとも設定するか、3つとも空にするかのどちらか。** 半端な状態はサーバーの起動時に落とす。
# 特に許可メールだけが空だと「Googleアカウントがあれば誰でも開ける」状態になるため。
# 3つとも空なら、従来どおり AIDE_AUTH_PASSWORD でのログインになる。
#
# 設定するときは、Supabaseダッシュボードの Authentication > URL Configuration > Redirect URLs に
#   <AIDE_BASE_URL>/status/auth/callback**
# を登録しておく必要がある。**末尾の ** を省かないこと。** 照合はフラグメントだけを落とし、
# クエリは付いたまま行われる。実際の戻り先は state を載せた ...callback?state=<乱数> なので、
# パスだけを完全一致で登録しても一致せず、Supabaseはエラーを返さずプロジェクトの Site URL へ
# 静かに倒す（＝ログインは成功したのに別のアプリの画面が開く。#93）。
# ローカルで試す場合は AIDE_BASE_URL=http://localhost:19090 を設定し、そのURLも登録する。
#
# 登録できているかは、AIDE_BASE_URL があればサーバーの起動時に自動で確認してログに出る（#114）。
# ログインできる状態なら /status の「疎通を確認する」からも確認できる。
#
# URLと公開鍵の値の正は 1Password の共有アイテム（op://apps/Supabase/project-url /
# op://apps/Supabase/publishable-key）。許可メールは op://apps/aide/status-allowed-emails。
AIDE_SUPABASE_URL=
AIDE_SUPABASE_PUBLISHABLE_KEY=
# 画面を開いてよいメールアドレス。カンマ区切りで複数書ける。
AIDE_STATUS_ALLOWED_EMAILS=

# MCPへのアクセスの記録の置き場（#116）。未設定なら data/mcp-access.json（リポジトリ基準）。
# 中身は時刻・メソッド・ツール名・クライアント名・成否・所要時間だけで、
# ツールの引数と応答、アクセス元IP、トークンは書かない。
# AIDE_MCP_ACCESS_LOG_PATH=

# ---- worker からの取り込み ----
# サーバー側: 受け口を有効にするシークレット。未設定なら受け口は503を返す。
# worker側:  送信先URLとシークレット。URLが無ければローカルのキャッシュへ書く。
AIDE_INGEST_SECRET=
# AIDE_INGEST_URL=https://aide.gucchii.com

# ---- 個人アプリ向けの読み取りAPI ----
# asset-manager 等が GET /api/money/summary を叩くためのシークレット。
# 未設定なら読み取り口は503を返す（開かない）。
# **書き込み用の AIDE_INGEST_SECRET とは別の値にする。** 同じ値にすると、読みたいだけの
# アプリへキャッシュの書き込み権限まで渡すことになる。
# 実値は本番の .env と 1Password にだけ置く。
AIDE_READ_SECRET=

# ---- Zaimへの支出登録（#37）----
# car-care（給油記録）・asset-manager（レシート由来の支出）が POST /api/zaim/payment を叩いて
# Zaimへ支出を登録するための設定。**巡回（Playwright）とはまったく別の経路**で、
# こちらは公式APIを OAuth 1.0a で叩く。資格情報も storage state とは別物。
#
# 値が要るのは**VPS側だけ**（登録はサーバーの同期リクエストで完結し、workerは関わらない）。
# 5つのうち1つでも欠けていれば /api/zaim/* は503を返し、口そのものが開かない。
#
# 呼び出し元アプリの認証用シークレット。
# **AIDE_READ_SECRET・AIDE_INGEST_SECRET とは別の値にする。** 同じ値にすると、残高を読みたい
# だけのアプリへZaimへ書き込む権限まで渡すことになる。
AIDE_ZAIM_WRITE_SECRET=

# Zaim APIの OAuth 1.0a。consumer key/secret は dev.zaim.net でのアプリ登録で発行する。
# access token は下のスクリプトで1回だけ取得する（ブラウザでの認可が要るため、GUIのある端末で行う）。
#   node src/core/connectors/zaim/scripts/oauth-token.mjs
# 実値は本番の .env と 1Password にだけ置く。
AIDE_ZAIM_CONSUMER_KEY=
AIDE_ZAIM_CONSUMER_SECRET=
AIDE_ZAIM_ACCESS_TOKEN=
AIDE_ZAIM_ACCESS_TOKEN_SECRET=

# 二重登録を防ぐ記録の置き場。未設定なら data/zaim-payments.json（リポジトリ基準）。
# 中身は requestId・money_id・時刻だけで、金額や店名は書かない。
# AIDE_ZAIM_PAYMENT_LOG_PATH=

# Web版の入力画面から登録した記録の置き場（#214）。未設定なら data/zaim-web-payments.json。
# **公式API経由とは別のファイル**にしている。あちらは money_id が入っていることを「確定した」の
# 印にしているが、Web版の画面はレコードidを表示しないため、同じ読み方ができない。
# 中身は requestId・状態・時刻だけで、金額や店名は書かない。
# AIDE_ZAIM_WEB_PAYMENT_LOG_PATH=

# ---- ops-dashboard（VPS・サブPCの稼働状況）----
# 稼働状況は ops-dashboard が既に集約している。AIDEは集め直さず、その読み取りAPIを叩いて
# aide_ops_status に畳む。両方とも同じVPS上で動くため localhost で届き、外部公開は要らない。
# トークンが未設定ならツールは「未設定」を返すだけで、取得を試みない。
# 実値は本番の .env と 1Password にだけ置く（ops-dashboard 側の OPS_API_TOKEN と同じ値）。
# AIDE_OPS_DASHBOARD_URL=http://127.0.0.1:3110
AIDE_OPS_DASHBOARD_TOKEN=

# ---- subscription-lists（月額固定費）----
# 月額固定費と次の支払予定は subscription-lists が既に持っている。AIDEは持ち直さず、
# サーバー間参照用の読み取りAPI（GET /api/internal/subscriptions）を叩いて
# aide_money_summary に畳む。ops-dashboard と同じく localhost で届き、外部公開は要らない。
# トークンが未設定なら固定費は「未設定」を返すだけで、取得を試みない（残高は従来どおり返る）。
# 実値は本番の .env と 1Password にだけ置く
# （subscription-lists 側の INTERNAL_API_KEY と同じ値。片方だけ変えると連携が止まる）。
# AIDE_SUBSCRIPTIONS_URL=http://127.0.0.1:3107
AIDE_SUBSCRIPTIONS_TOKEN=

# ---- myroom（部屋の状態）----
# 室温・湿度・気圧・CO2・照度とエアコンの状態は myroom が既に集めている。AIDEは集め直さず、
# サーバー間参照用の読み取りAPI（GET /api/internal/room-state）を叩いて aide_room_status に畳む。
# ops-dashboard と同じく localhost で届き、外部公開は要らない。
# トークンが未設定ならツールは「未設定」を返すだけで、取得を試みない。
# 実値は本番の .env と 1Password にだけ置く
# （myroom 側の内部APIキーと同じ値。片方だけ変えると連携が止まる）。
# AIDE_MYROOM_URL=http://127.0.0.1:8000
AIDE_MYROOM_TOKEN=

# ---- DaySpan（予定・タスク・日付リマインド・移動）----
# 予定（Googleカレンダー）とタスク・日付リマインド（Notion）は DaySpan が既に統合している。
# AIDEはGoogleカレンダーへ直接繋がず、サーバー間参照用の読み取りAPI
# （GET /api/internal/schedule）を叩いて aide_schedule と aide_daily_briefing の予定に畳む。
# Googleカレンダー用のOAuthクライアントとリフレッシュトークンは DaySpan 側にあり、
# AIDEへ同じ認可経路をもう1本作らない（#173）。
# ops-dashboard と同じく localhost で届き、外部公開は要らない。
# トークンが未設定ならツールは「未設定」を返すだけで、取得を試みない。
# 実値は本番の .env と 1Password にだけ置く
# （DaySpan 側の INTERNAL_API_KEY と同じ値。片方だけ変えると連携が止まる）。
# AIDE_DAYSPAN_URL=http://127.0.0.1:3113
AIDE_DAYSPAN_TOKEN=

# ---- GitHub（開発状況・共通知識）----
# 2つの読み取りに使う。どちらも GraphQL v4 で、書き込みは一切しない。
#   1. 各リポジトリの開発状況（最新リリース・未リリースの差分・Issue/PR・CI）→ aide_dev_status
#   2. 全アプリ共通の共有知識と、知見メモの格上げ判定の記録（#161）→ 画面 /knowledge
# ClaudeアプリにはGitHubのコネクタが無いため、AIDEが出してよい領域にあたる。
# トークンが未設定ならツールも画面も「未設定」と出すだけで、GitHubへアクセスしない。
#
# fine-grained PAT を使う。必要な権限はすべて Read-only:
#   Metadata / Contents / Issues / Pull requests / Actions
#
# **対象リポジトリに guchi-apps/docs を含めること**（/knowledge が読む共有知識の置き場で、
# private のため対象に入っていないと GraphQL が NOT_FOUND を返す。権限不足と存在しない
# リポジトリはGitHubでは同じ応答になるので、画面には「取得できなかった」と出る）。
# 実値は本番の .env と 1Password にだけ置く。
AIDE_GITHUB_TOKEN=

# ---- GitHub（Issueの起票・#50）----
# ClaudeアプリからIssueを起票する（aide_create_issue）ための**書き込み用トークン**。
# Claude Code（端末・GitHub Actions）は gh issue create で起票できるが、Claudeアプリからの
# 経路だけが塞がっているためAIDEに口を置く。作成のみで、編集・close・コメントは行わない。
# 未設定ならツールは「未設定」を返すだけで、GitHubへアクセスしない。
#
# **上の AIDE_GITHUB_TOKEN とは別の fine-grained PAT にする。** 取得側はRead-onlyのままにして、
# 書き込み権限をこのトークンだけに閉じ込める（AIDE_INGEST_SECRET と AIDE_READ_SECRET を
# 分けているのと同じ理由）。フォールバックはしない。
# 必要な権限は Metadata: Read-only と **Issues: Read and write** の2つだけ。
# 実値は本番の .env と 1Password にだけ置く。
AIDE_GITHUB_ISSUE_TOKEN=

# 対象Organization。未設定なら guchi-apps。
# AIDE_GITHUB_ORG=guchi-apps

# 対象リポジトリを固定したい場合はカンマ区切りで指定する。
# 未設定なら「archived を除き、直近 AIDE_GITHUB_ACTIVE_DAYS 日にpushがあったもの」を自動で拾う。
# AIDE_GITHUB_REPOS=aide,issue-deck
# AIDE_GITHUB_ACTIVE_DAYS=90

# ---- ジョブ失敗の通知（Signaly）----
# worker ジョブの失敗と復旧を Signaly のWebhookへ送る。未設定なら通知しない（開発機）。
# URLに含まれる channel_id が宛先の識別子そのものなので、認証情報として扱うこと。
# 実値はサブPCの .env と 1Password にだけ置く。
AIDE_SIGNALY_WEBHOOK_URL=

# ---- 天気予報（Open-Meteo）----
# 朝のブリーフィングの材料として、今日・明日の天気・最高／最低気温・降水確率を取得する。
# **APIキーは要らない**（無料枠は非商用・1日10,000回未満・CC BY 4.0 の帰属表示が条件）。
# 取得するのは worker（weather-sync ジョブ）なので、値が要るのはサブPCの .env だけ。
# VPS側はキャッシュを読むだけなので設定しなくてよい。
#
# 予報を出す地点。未設定なら 34.82 / 135.56（myroom の OUTDOOR_LAT / OUTDOOR_LON と同じ）。
# 書き間違えると別の地点の予報が「正常に」入るため、数値として読めない値は起動時に失敗させる。
# AIDE_WEATHER_LAT=34.82
# AIDE_WEATHER_LON=135.56
