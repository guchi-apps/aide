# AIDE の設定。実際の値は .env に置く（.env はコミットしない）。
# ここにあるのは公開URLとCSSセレクタで、機密情報ではない。
# APIキー・トークン類を追加する場合は 1Password の op:// 参照を使うこと。

# ---- サーバー ----
# HOST=127.0.0.1
# PORT=4747

# ---- Zaim ----
# Zaim は公式APIで残高を取れないため、Playwright で画面を巡回して取得する。
# 初回は GUI のある端末で手動ログインして storage state を保存する。
#   node src/core/connectors/zaim/scripts/login.mjs

ZAIM_LOGIN_URL=https://zaim.net/
ZAIM_BALANCE_URL=https://zaim.net/home

# ログイン状態の保存先。未設定なら data/zaim/storage-state.json（リポジトリ基準）。
# ZAIM_STORAGE_STATE_PATH=

# ---- Zaim: 自動再ログイン（任意）----
# セッションが失効したときに自動でログインし直すための資格情報（#63）。
# **両方を設定したときだけ有効になる。** 未設定なら従来どおり ZAIM_SESSION_EXPIRED で
# 失敗させ、手動ログインをやり直す運用になる（開発機・CIではこちらが既定）。
#
# 値の正は 1Password（op://apps/aide/zaim-email / op://apps/aide/zaim-password）に置く。
# 実行時に 1Password は呼ばないため、worker が動くサブPCの .env へ人が転記する。
# **VPS側には要らない**（worker はサブPCで動き、VPSはキャッシュを読むだけ）。
ZAIM_EMAIL=
ZAIM_PASSWORD=

# ログイン画面のセレクタ。未設定なら type/name 属性から総当たりで探す。
# Zaim のログインは id.kufu.jp の SSO 画面へ飛び、構成が変わりうるため上書き口を用意する。
ZAIM_LOGIN_EMAIL_SELECTOR=
ZAIM_LOGIN_PASSWORD_SELECTOR=
ZAIM_LOGIN_SUBMIT_SELECTOR=

# 残高一覧の抽出。未設定の場合は「名称＋円金額」を総当たりで拾うフォールバックが働くが、
# 誤検出を避けるため実運用ではセレクタを指定する。
ZAIM_BALANCE_ROW_SELECTOR="section.box.home-balance div.col-xs-7.text.account-name"
ZAIM_BALANCE_NAME_SELECTOR=.name
ZAIM_BALANCE_AMOUNT_SELECTOR=.value

# 証券は残高一覧に合計しか出ないため、詳細ページを巡回して個別銘柄を取得する。
# 未設定なら a[href*="/securities/"] を使う。
ZAIM_SECURITIES_LINK_SELECTOR=
ZAIM_SECURITIES_ACCOUNT_NAME_SELECTOR=h2

# 証券詳細ページの表は列構成が揃わないため、ヘッダー見出しで評価額の列を特定する。
ZAIM_SECURITIES_HOLDING_TABLE_SELECTOR=table
ZAIM_SECURITIES_HOLDING_NAME_HEADERS=銘柄,ファンド名
ZAIM_SECURITIES_HOLDING_AMOUNT_HEADERS=評価額

# 表から取れない場合に使う行セレクタ。
ZAIM_SECURITIES_HOLDING_ROW_SELECTOR=
ZAIM_SECURITIES_HOLDING_NAME_SELECTOR=
ZAIM_SECURITIES_HOLDING_AMOUNT_SELECTOR=

# ---- 認証（必須）----
# 未設定だとサーバーは起動しない。認証なしで動かす場合は AIDE_AUTH_DISABLED=1 を明示する。
# 本番では 1Password から注入する。
AIDE_AUTH_PASSWORD=

# OAuthメタデータに載せる公開URL。リバースプロキシ配下ではHostから推測できないため明示する。
# 例: https://aide.gucchii.com
AIDE_BASE_URL=

# ---- worker からの取り込み ----
# サーバー側: 受け口を有効にするシークレット。未設定なら受け口は503を返す。
# worker側:  送信先URLとシークレット。URLが無ければローカルのキャッシュへ書く。
AIDE_INGEST_SECRET=
# AIDE_INGEST_URL=https://aide.gucchii.com

# ---- 個人アプリ向けの読み取りAPI ----
# asset-manager 等が GET /api/money/summary を叩くためのシークレット。
# 未設定なら読み取り口は503を返す（開かない）。
# **書き込み用の AIDE_INGEST_SECRET とは別の値にする。** 同じ値にすると、読みたいだけの
# アプリへキャッシュの書き込み権限まで渡すことになる。
# 実値は本番の .env と 1Password にだけ置く。
AIDE_READ_SECRET=

# ---- ops-dashboard（VPS・サブPCの稼働状況）----
# 稼働状況は ops-dashboard が既に集約している。AIDEは集め直さず、その読み取りAPIを叩いて
# aide_ops_status に畳む。両方とも同じVPS上で動くため localhost で届き、外部公開は要らない。
# トークンが未設定ならツールは「未設定」を返すだけで、取得を試みない。
# 実値は本番の .env と 1Password にだけ置く（ops-dashboard 側の OPS_API_TOKEN と同じ値）。
# AIDE_OPS_DASHBOARD_URL=http://127.0.0.1:3110
AIDE_OPS_DASHBOARD_TOKEN=

# ---- subscription-lists（月額固定費）----
# 月額固定費と次の支払予定は subscription-lists が既に持っている。AIDEは持ち直さず、
# サーバー間参照用の読み取りAPI（GET /api/internal/subscriptions）を叩いて
# aide_money_summary に畳む。ops-dashboard と同じく localhost で届き、外部公開は要らない。
# トークンが未設定なら固定費は「未設定」を返すだけで、取得を試みない（残高は従来どおり返る）。
# 実値は本番の .env と 1Password にだけ置く
# （subscription-lists 側の INTERNAL_API_KEY と同じ値。片方だけ変えると連携が止まる）。
# AIDE_SUBSCRIPTIONS_URL=http://127.0.0.1:3107
AIDE_SUBSCRIPTIONS_TOKEN=

# ---- GitHub（開発状況）----
# 各リポジトリの開発状況（最新リリース・未リリースの差分・Issue/PR・CI）を aide_dev_status に畳む。
# ClaudeアプリにはGitHubのコネクタが無いため、AIDEが出してよい領域にあたる。
# GraphQL v4 を1リクエスト叩くだけで、書き込みは一切しない。
# トークンが未設定ならツールは「未設定」を返すだけで、GitHubへアクセスしない。
#
# fine-grained PAT を使う。必要な権限はすべて Read-only:
#   Metadata / Contents / Issues / Pull requests / Actions
# 実値は本番の .env と 1Password にだけ置く。
AIDE_GITHUB_TOKEN=

# 対象Organization。未設定なら guchi-apps。
# AIDE_GITHUB_ORG=guchi-apps

# 対象リポジトリを固定したい場合はカンマ区切りで指定する。
# 未設定なら「archived を除き、直近 AIDE_GITHUB_ACTIVE_DAYS 日にpushがあったもの」を自動で拾う。
# AIDE_GITHUB_REPOS=aide,issue-deck
# AIDE_GITHUB_ACTIVE_DAYS=90

# ---- ジョブ失敗の通知（Signaly）----
# worker ジョブの失敗と復旧を Signaly のWebhookへ送る。未設定なら通知しない（開発機）。
# URLに含まれる channel_id が宛先の識別子そのものなので、認証情報として扱うこと。
# 実値はサブPCの .env と 1Password にだけ置く。
AIDE_SIGNALY_WEBHOOK_URL=
