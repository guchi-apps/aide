[Unit]
Description=AIDE: Zaimの巡回（1日2回・11:35/23:35 JST）

[Timer]
# subpc のシステムTZは UTC のため、JSTを明示する。
# それぞれ65分前の aide-zaim-refresh が押した更新の反映を待ってから巡回する。反映は多くの
# 口座で5〜15分だが、SBI証券などは約35分かかる。20分間隔では間に合わず、当日ぶんの残高が
# 前日の値のまま記録されていた（#178）。
# 23:35 は**その日のうちに**当日の残高を確定させるための時刻（#62。以前は05:00 JSTだったが、
# その時刻では更新ボタンを押した当日ぶんが翌日のキャッシュにしか載らなかった）。
# 11:35 は12時間ずらした1回で、キャッシュの最大経過を24時間から12時間へ縮める（#165）。
OnCalendar=*-*-* 11,23:35:00 Asia/Tokyo
Persistent=true
# RandomizedDelaySec は置かない。aide-zaim-refresh との65分の間隔が「更新の反映を待つ」
# 根拠そのもので、両方に揺らぎを入れると順序が入れ替わりうる。1日2回なのでZaim側への
# アクセスが集中する心配もない。

[Install]
WantedBy=timers.target
