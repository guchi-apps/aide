[Unit]
Description=AIDE: Zaimセッションの延長（30分ごと）

[Timer]
# Cookieの有効期間は約2時間で、アクセスのたびにその時点から延長される。
# つまり「2時間以内に1回でも成功したか」だけで維持できるかが決まる。
#
# 以前は毎時 + RandomizedDelaySec=5min で最悪間隔が1時間5分あり、
# **1回失敗するだけで最悪2時間10分空いて期限を超えていた**（#63）。
# 30分ごと + 2分の揺らぎなら最悪でも32分間隔になり、3回続けて失敗しても間に合う。
OnCalendar=*:00,30
# 停止中に逃した実行を起動直後に走らせる。丸一日落ちていても復帰時に維持を再開できる。
Persistent=true
# 毎時ちょうどに固定でアクセスしない。上の余裕を潰さないよう短めに取る。
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
