[Unit]
Description=AIDE: Zaimの連携口座を一括更新（1日2回・11:15/23:15 JST）

[Timer]
# subpc のシステムTZは UTC のため、JSTを明示する。
# 押してから各金融機関への再取得が反映されるまで5〜15分かかり、20分後の aide-zaim-sync が巡回する。
#
# 23:15 は「24時までにその日の最終データを確定させる」ための逆算（#62）。
# 11:15 はそこから12時間ずらした1回で、**日中に残高を尋ねたとき前夜の値しか返らない**状態を
# 縮めるために足した（#165）。夜の1回は動かさないので、当日ぶんの確定は従来どおり保たれる。
OnCalendar=*-*-* 11,23:15:00 Asia/Tokyo
Persistent=true
# RandomizedDelaySec は置かない（理由は aide-zaim-sync.timer と同じ）。

[Install]
WantedBy=timers.target
