[Unit]
Description=AIDE: Zaimの連携口座を一括更新（1日2回・10:30/22:30 JST）

[Timer]
# subpc のシステムTZは UTC のため、JSTを明示する。
#
# 23:15 は「24時までにその日の最終データを確定させる」ための逆算だった（#62）。
# **押してから反映されるまでの時間は口座によって大きく違う**。多くは5〜15分だが、
# SBI証券・楽天証券・Ponta・MUFGカードは**約35分後**にしか反映されず、20分後に走る
# aide-zaim-sync の巡回に間に合わなかった（#178）。巡回までの間隔を65分へ広げるために
# 45分前倒しして 22:30 に置く。aide-zaim-sync の 23:35 は動かさないので、
# 「23:59までにその日ぶんが確定する」という #62 の前提はそのまま保たれる。
#
# 10:30 はそこから12時間ずらした1回で、**日中に残高を尋ねたとき前夜の値しか返らない**状態を
# 縮めるために足したもの（#165）。夜の1回との12時間差を保つため、同じ45分だけ前へずらした。
OnCalendar=*-*-* 10,22:30:00 Asia/Tokyo
Persistent=true
# RandomizedDelaySec は置かない（理由は aide-zaim-sync.timer と同じ）。

[Install]
WantedBy=timers.target
